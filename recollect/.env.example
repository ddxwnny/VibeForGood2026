# Recollect backend — environment template. Copy to `.env` (never committed)
# and fill in real values. Every RECOLLECT_* var maps to a `Settings` field.

# Runtime mode: "dev" permits in-memory adapters for unconfigured services;
# anything else requires every service below or the app refuses to boot.
RECOLLECT_ENVIRONMENT=dev

# --- Persistence (PostgreSQL) ---
RECOLLECT_DATABASE_URL=postgresql+asyncpg://recollect:recollect@localhost:5432/recollect

# --- LLM (Anthropic) ---
RECOLLECT_ANTHROPIC_API_KEY=
RECOLLECT_ANTHROPIC_MODEL_ID=claude-sonnet-5
RECOLLECT_ANTHROPIC_WEEKLY_MODEL_ID=claude-opus-5

# --- TTS (ElevenLabs) ---
RECOLLECT_ELEVENLABS_API_KEY=
RECOLLECT_ELEVENLABS_VOICE_ID=
RECOLLECT_ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- STT (provider undecided — see Architecture Spine Deferred) ---
RECOLLECT_STT_BASE_URL=
RECOLLECT_STT_API_KEY=

# --- Key management (AD-13; custody deferred) ---
RECOLLECT_VAULT_URL=
RECOLLECT_VAULT_TOKEN=

# --- Device + phone-surface credentials (NFR-15, AD-14, AD-16) ---
# Shared key the device presents to record heartbeats and addressed turns.
# The senior never authenticates. In dev mode an empty key is permissive;
# in production a missing/unknown key is rejected (401).
RECOLLECT_DEVICE_API_KEY=

# Human surfaces (care worker, named recipient) authenticate with per-grant
# API keys stored in the `grants` table (hashed). Grants are minted out-of-band
# (no self-serve endpoint in v1); see `adb grant` / the GrantStorePort.
