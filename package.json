    "ios:open": "cap sync ios && cap open ios",
    "ios:run": "cap sync ios && cap run ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1"
  }
}
